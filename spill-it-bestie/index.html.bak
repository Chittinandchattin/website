<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Spill it, bestie - share the funny, messy, chaotic tea with Chittin' and Chattin'." />
    <title>Spill it, bestie</title>
    <link rel="icon" href="/assets/brand/icon.png" type="image/png" />
    <link rel="stylesheet" href="/assets/css/site.css" />
    <link rel="canonical" href="https://chittinandchattin.com/spill-it-bestie/" />
</head>
  <body>
    <div id="app"></div>
    <script src="/assets/js/config.js"></script>
    <script src="/assets/js/site.js"></script>
    <script>
      initPage({
        title: "Spill it, bestie",
        description: "Spill it, bestie - share the funny, messy, chaotic tea with Chittin' and Chattin'.",
        activePath: "/spill-it-bestie/",
        content: renderFeaturePage({
          eyebrow: "Spill it, bestie",
          title: "Spill it, bestie",
          intro: "Whether you're holding something heavy or just have a little tea to spill, our inboxes are open.",
          body: `<p><strong>Spill it, bestie</strong> is for the funny, messy, and chaotic moments that need to be shared - the kind of story you would tell your group chat before you tell anyone else.</p>
            <p>There is no pressure to have the perfect wording. Share whatever you feel called to, when you feel ready. We read every submission and love featuring listener stories when the moment fits an episode.</p>
            <p>Use the form below to share your story. You can also DM us on Instagram for a quick note. Please do not include passwords, financial account numbers, or other sensitive identifiers.</p>`,
          image: "/assets/features/spill-it-bestie.jpg",
          inboxType: "spill",
        }),
      });
      bindInboxForm({
        inboxType: "spill",
        subjectPrefix: "Chittin' and Chattin'' - Spill it, bestie",
      });
    </script>
  </body>
</html>
