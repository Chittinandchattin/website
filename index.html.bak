<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Chittin' and Chattin' - two besties navigating life, healing, and laughing through the chaos. Listen on Spotify, Apple, YouTube, and everywhere else." />
    <title>Chittin' and Chattin'</title>
    <link rel="icon" href="/assets/brand/icon.png" type="image/png" />
    <link rel="stylesheet" href="/assets/css/site.css" />
    <link rel="canonical" href="https://chittinandchattin.com/" />
</head>
  <body>
    <div id="app"></div>
    <script src="/assets/js/config.js"></script>
    <script src="/assets/js/site.js"></script>
    <script>
      initPage({
        title: "Chittin' and Chattin'",
        description: "Chittin' and Chattin' - two besties navigating life, healing, and laughing through the chaos.",
        activePath: "/",
        hero: true,
        adSlots: false,
        content: `
          ${renderTeaser({
            eyebrow: "Spill it, bestie",
            title: "Got tea?",
            body: "Funny, messy, chaotic moments that need to be shared - our inboxes are open. Use the form and we might read it on the podcast.",
            href: "/spill-it-bestie/",
            cta: "Spill it, bestie",
            image: "/assets/features/spill-it-bestie.jpg",
          })}
          ${renderTeaser({
            eyebrow: "Healing inbox",
            title: "Need care & space?",
            body: "Tender questions, feelings, and stories that want to be held gently. Use the form when you're ready - no pressure on what to say.",
            href: "/healing-inbox/",
            cta: "Healing inbox",
            image: "/assets/features/healing-inbox.jpg",
            reverse: true,
          })}
          ${renderTeaser({
            eyebrow: "Sips of the Week",
            title: "Every episode, a new sip",
            body: "Browse the full archive - teas, coffees, cocktails, and whatever chaos we brewed that week. Got a favorite drink? Suggest a Sip.",
            href: "/sips/",
            cta: "Browse Sips",
            secondaryHref: "/suggestasip/",
            secondaryCta: "Suggest a Sip",
            image: "/assets/features/sips-of-the-week.png",
          })}
          ${renderTeaser({
            eyebrow: "Bestie break",
            title: "Slider puzzle",
            body: "Sip your tea, listen to us chit-chat, and unwind with a cozy little puzzle.",
            href: "/puzzle/",
            cta: "Play the puzzle",
            image: "/assets/brand/hero.png",
            reverse: true,
          })}
        `,
      });
    </script>
  </body>
</html>
