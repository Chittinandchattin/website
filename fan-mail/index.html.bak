<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Fan mail for Chittin' and Chattin' - message M or Syd about collabs, business inquiries, or being on the show." />
    <title>Fan mail</title>
    <link rel="icon" href="/assets/brand/icon.png" type="image/png" />
    <link rel="stylesheet" href="/assets/css/site.css" />
    <link rel="canonical" href="https://chittinandchattin.com/fan-mail/" />
</head>
  <body>
    <div id="app"></div>
    <script src="/assets/js/config.js"></script>
    <script src="/assets/js/site.js"></script>
    <script>
      initPage({
        title: "Fan mail",
        description: "Fan mail for Chittin' and Chattin' - message M or Syd about collabs, business inquiries, or being on the show.",
        activePath: "/fan-mail/",
        content: renderFanMailPage(),
      });
      bindInboxForm({
        inboxType: "contact",
        subjectPrefix: "Chittin' and Chattin' - Fan mail",
      });
      bindFanMailPage();
    </script>
  </body>
</html>
